    {
      "parameters": {
        "jsCode": "// Pull the browser-set Origin (falls back to parsing Referer's origin -\n// never the raw Referer, which can include a path/query).\nconst headers = $json.headers || {};\nlet origin = headers.origin || '';\nif (!origin && headers.referer) {\n  try { origin = new URL(headers.referer).origin; } catch (e) { origin = ''; }\n}\n\nconst query = $json.query || {};\nconst companyId = query.companyId || query.company_id || '';\n\n// company_id is a uuid column in Postgres - reject non-uuid values here so\n// a malformed companyId fails closed instead of throwing a cast error in\n// the Lookup Domain query.\nconst UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nconst validRequest = Boolean(origin) && UUID_RE.test(companyId);\n\nreturn [{ json: { ...$json, origin, companyId, validRequest } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        176
      ],
      "id": "e1a2b3c4-1111-4a1b-9c2d-3e4f5a6b7c8d",
