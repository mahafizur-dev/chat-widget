        "path": "api/v1/ably-token-chatbot",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 0],
      "id": "a1b2c3d4-0001-4a1b-9c2d-3e4f5a6b7c8d",
      "name": "Webhook",
      "webhookId": "e1f2a3b4-c5d6-4e7f-8a9b-0c1d2e3f4a5b"
    },
    {
      "parameters": {
        "jsCode": "// Pull the browser-set Origin (falls back to parsing Referer's origin -\n// never the raw Referer, which can include a path/query).\nconst headers = $json.headers || {};\nlet origin = headers.origin || '';\nif (!origin && headers.referer) {\n  try { origin = new URL(headers.referer).origin; } catch (e) { origin = ''; }\n}\n\nconst body = $json.body || {};\nconst companyId = body.companyId || '';\nconst sessionId = body.sessionId || '';\n\n// company_id is a uuid column in Postgres - reject non-uuid values here so\n// a malformed companyId fails closed instead of throwing a cast error in\n// the Lookup Domain query.\nconst UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nconst validRequest = Boolean(origin) && UUID_RE.test(companyId);\n\nreturn [{ json: { ...$json, origin, companyId, sessionId, validRequest } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0],
      "id": "a1b2c3d4-0002-4a1b-9c2d-3e4f5a6b7c8d",
      "name": "Extract Origin & Company"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "request-valid-cond",
              "leftValue": "={{ $json.validRequest }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, 0],
      "id": "a1b2c3d4-0010-4a1b-9c2d-3e4f5a6b7c8d",
      "name": "Request Valid?"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT EXISTS (\n  SELECT 1 FROM presswayy.company_domains\n  WHERE company_id = $1::uuid AND domain = $2 AND verification_status = 'verified'\n) AS allowed",
        "options": {
          "queryReplacement": "={{ [$json.companyId, $json.origin] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [600, 0],
      "id": "a1b2c3d4-0011-4a1b-9c2d-3e4f5a6b7c8d",
      "name": "Lookup Domain",
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_YOUR_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "origin-allowed-cond",
              "leftValue": "={{ $json.allowed }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [780, 0],
      "id": "a1b2c3d4-0003-4a1b-9c2d-3e4f5a6b7c8d",
      "name": "Origin Allowed?"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"error\": \"Origin not allowed\" } }}",
        "options": {
          "responseCode": 403
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [600, 220],
      "id": "a1b2c3d4-0004-4a1b-9c2d-3e4f5a6b7c8d",
      "name": "Respond Forbidden"
    },
    {
      "parameters": {
        "jsCode": "const src = $('Extract Origin & Company').item.json;\nconst companyId = src.companyId;\nconst sessionId = src.sessionId;\n\nif (!companyId || !sessionId) {\n  return [{ json: { inputValid: false, error: 'companyId and sessionId are required' } }];\n}\n\n// Must match the channel name the widget subscribes to (chat-widget.js).\nconst channel = `chat-${companyId}-${sessionId}`;\n// Least privilege: the browser only ever subscribes, so the minted token\n// never carries publish/presence/history capability.\nconst capability = JSON.stringify({ [channel]: ['subscribe'] });\n\n// keyName (appId.keyId) is the public half of the Ably key - not a secret.\n// EDIT ME: paste the part of your Ably root key BEFORE the colon.\n// The secret half (after the colon) lives only in the \"Ably Root Key\"\n// HTTP Basic Auth credential attached to the Request Ably Token node below.\nconst keyName = 'REPLACE_WITH_YOUR_ABLY_KEY_NAME';\n\nreturn [{\n  json: { inputValid: true, channel, capability, clientId: sessionId, keyName },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 0],
      "id": "a1b2c3d4-0005-4a1b-9c2d-3e4f5a6b7c8d",
      "name": "Build Token Request"
    },
