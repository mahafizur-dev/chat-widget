          },
          "conditions": [
            {
              "id": "input-valid-cond",
              "leftValue": "={{ $json.inputValid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1220, 0],
      "id": "a1b2c3d4-0006-4a1b-9c2d-3e4f5a6b7c8d",
