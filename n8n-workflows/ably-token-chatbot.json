    },
    {
      "parameters": {
        "jsCode": "const allowed = ($env.ALLOWED_CHATBOT_ORIGINS || '')\n  .split(',')\n  .map((s) => s.trim())\n  .filter(Boolean);\n\nconst headers = $json.headers || {};\nconst origin = headers.origin || headers.referer || '';\nconst originAllowed =\n  allowed.length > 0 &&\n  allowed.some((a) => origin === a || origin.indexOf(a + '/') === 0);\n\nreturn [{ json: { ...$json, origin, originAllowed } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0],
      "id": "a1b2c3d4-0002-4a1b-9c2d-3e4f5a6b7c8d",
      "name": "Check Origin"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "origin-allowed-cond",
              "leftValue": "={{ $json.originAllowed }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, 0],
      "id": "a1b2c3d4-0003-4a1b-9c2d-3e4f5a6b7c8d",
      "name": "Origin Allowed?"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"error\": \"Origin not allowed\" } }}",
        "options": {
          "responseCode": 403
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [660, 180],
      "id": "a1b2c3d4-0004-4a1b-9c2d-3e4f5a6b7c8d",
      "name": "Respond Forbidden"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || {};\nconst companyId = body.companyId;\nconst sessionId = body.sessionId;\n\nif (!companyId || !sessionId) {\n  return [{ json: { inputValid: false, error: 'companyId and sessionId are required' } }];\n}\n\n// Must match the channel name the widget subscribes to (chat-widget.js).\nconst channel = `chat-${companyId}-${sessionId}`;\n// Least privilege: the browser only ever subscribes, so the minted token\n// never carries publish/presence/history capability.\nconst capability = JSON.stringify({ [channel]: ['subscribe'] });\n\nconst rootKey = $env.ABLY_ROOT_KEY || '';\nconst keyName = rootKey.split(':')[0];\nconst authHeader = 'Basic ' + Buffer.from(rootKey).toString('base64');\n\nreturn [{\n  json: { inputValid: true, channel, capability, clientId: sessionId, keyName, authHeader },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0],
      "id": "a1b2c3d4-0005-4a1b-9c2d-3e4f5a6b7c8d",
      "name": "Build Token Request"
